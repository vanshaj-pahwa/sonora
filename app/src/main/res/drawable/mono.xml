<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared by two consumers with different rules, so it is authored to satisfy
  the stricter one:

    NotificationHandler.setSmallIcon  - Android uses this as an ALPHA MASK and
                                        discards the colour, so it must be a
                                        flat silhouette on a transparent ground.
    MainAppWidget                     - draws it at 40dp as a normal image, so
                                        it renders white.

  Filled rounded rects rather than strokes, inset inside the 24dp box so the
  status bar does not clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
